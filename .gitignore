# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files -- NEVER commit real secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
# These are safe to commit (no real secrets):
!.env.example
!.env.development
!.env.test

# Upload directories
uploads/
uploads-test/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# QA harness output (regenerated by scripts/homepage-qa.ts)
screenshots/

# Local AI runtime (recreated by npm run ai:setup)
tools/local-ai/.venv/
tools/local-ai/models/
tools/local-ai/output/
__pycache__/
*.py[cod]

# Review renders (regenerated by npm run lion:review).
#
# 18 PNGs at ~6.4 MB that change on every run, and every one of them is
# derivable from the committed .blend files by one command. The stitched
# contact sheet IS tracked — it is the artefact anyone actually looks at, and
# it belongs in a commit or a PR as the visual record of what a change did.
docs/assets/lion-review/

# Subagent worktrees. Each is a full git checkout of this repo; committing them
# would embed one repository inside another.
.claude/worktrees/
