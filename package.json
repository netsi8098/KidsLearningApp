{
  "name": "kidslearningapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "ai:setup": "bash scripts/setup-local-ai.sh",
    "ai:start": "bash scripts/start-local-ai.sh",
    "ai:check": "curl -fsS http://localhost:5555/health",
    "lion:build": "blender --background --factory-startup --python tools/blender/build_rigged_lion.py",
    "lion:validate": "node scripts/validate-lion-glb.mjs",
    "lion:validate:cage": "node scripts/validate-lion-glb.mjs public/assets/lion/cage/lion.glb",
    "lion:assemble": "blender --background art/blender/lion_anim_cage.blend --factory-startup --python tools/blender/assemble_lion.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "test:e2e:child": "npx playwright test --config=e2e/playwright.config.ts --project=child-mobile --project=child-tablet",
    "test:e2e:parent": "npx playwright test --config=e2e/playwright.config.ts --project=parent-mobile --project=parent-desktop",
    "test:e2e:admin": "npx playwright test --config=e2e/playwright.config.ts --project=admin-desktop",
    "test:all": "npm run test && npm run test:backend && npm run test:admin",
    "test:backend": "cd backend && npx vitest run",
    "test:admin": "cd admin && npx vitest run",
    "test:ci": "npm run test -- --reporter=junit --outputFile=coverage/frontend-results.xml && npm run test:backend && npm run test:admin",
    "test:certify": "npm run test:all && npm run test:e2e",
    "env:build": "blender --background --factory-startup --python tools/blender/build_home_environment.py",
    "env:validate": "blender --background art/blender/home_environment.blend --factory-startup --python tools/blender/validate_home_environment.py",
    "env:export": "blender --background art/blender/home_environment.blend --factory-startup --python tools/blender/export_home_environment.py",
    "env:validate:glb": "node scripts/validate-environment-glb.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@types/three": "^0.185.4",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.38.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "three": "^0.185.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.8",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.2"
  }
}
