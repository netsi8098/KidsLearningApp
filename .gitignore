# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build cache — regenerated by any `tsc -b`,
# so tracking it means every local build dirties the working tree.
*.tsbuildinfo

# Environment files -- NEVER commit real secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
# These are safe to commit (no real secrets):
!.env.example
!.env.development
!.env.test

# Upload directories
uploads/
uploads-test/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# video-forge intermediates (scripts, TTS audio cache, captured frames)
tools/video-forge/.work/

# Test and QA artifacts — regenerated, sometimes very large. A hung browser
# recording once wrote a 152 GB .webm into screenshots/; keep these out of git.
# screenshots/ is also the QA harness output (scripts/homepage-qa.ts).
screenshots/
playwright-report/
e2e/test-results/
coverage/
test-results/

# Local AI runtime (recreated by npm run ai:setup)
tools/local-ai/.venv/
tools/local-ai/models/
tools/local-ai/output/
__pycache__/
*.py[cod]
